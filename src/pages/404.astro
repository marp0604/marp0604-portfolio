---
// Página 404: Vercel sirve dist/404.html para cualquier URL que no exista.
// Sin JS (no hace falta) y con noindex para que no acabe en Google.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import LogoMark from '../components/LogoMark.astro';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Página no encontrada — marp0604</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#16181d" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <main class="notfound">
      <div class="bg-glow" aria-hidden="true"></div>
      <div class="bg-grid" aria-hidden="true"></div>
      <div class="glow-blob" aria-hidden="true"></div>
      <div class="container">
        <a href="/" class="notfound-logo" aria-label="Inicio — marp0604"><LogoMark /></a>
        <p class="eyebrow">
          <span>Error 404</span>
          <span class="accent">página no encontrada</span>
        </p>
        <h1 class="hero-title">
          Esta página <span class="accent">no existe</span><span class="cursor" aria-hidden="true"></span>
        </h1>
        <p class="notfound-desc">
          Puede que el enlace esté mal escrito o que la página se haya movido. Todo lo demás sigue en la portada.
        </p>
        <div class="hero-actions">
          <a href="/" class="btn btn-primary">
            Volver al inicio
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
          <a href="/#contacto" class="btn btn-ghost">Contactar</a>
        </div>
      </div>
    </main>
  </body>
</html>
