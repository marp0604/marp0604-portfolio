---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import IconGitHub from '../components/IconGitHub.astro';
import IconLinkedIn from '../components/IconLinkedIn.astro';
import IconCV from '../components/IconCV.astro';
import LogoMark from '../components/LogoMark.astro';
// Fuente del titular (LCP): se precarga para que no espere a descubrirse en el CSS.
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

const cvUrl = "/CV-Miguel-Angel-Ramirez-Perez.pdf";

const rol = "Desarrollador Multiplataforma";
// Título de Google: la marca marp0604 y la intención de búsqueda (freelance + ciudad),
// en ~65 caracteres para que no se corte.
const titulo = "Miguel Ángel Ramírez (marp0604) — Desarrollador freelance en Almería";
// Meta description: ≤ 155 caracteres para que Google no la corte.
const descripcion = "Miguel Ángel Ramírez Pérez (marp0604), desarrollador multiplataforma en Almería. Freelance: webs con Astro y React y apps móviles con Kotlin Multiplatform.";
const canonicalURL = "https://marp0604.com/";
const ogImage = "https://marp0604.com/og-image.jpg";

const experiencia = [
  {
    empresa: "Farmacias.com",
    rol: "Desarrollador",
    periodo: "Feb. 2026 — Presente",
    ubicacion: "Aguadulce, Almería",
    descripcion: "Incorporado tras prácticas de formación dual. Mantenimiento, mejora y desarrollo de nuevas funcionalidades en plataforma e-commerce de farmacia. Trabajo en entorno de producto real, enfocado en calidad de código y estabilidad.",
    actual: true,
  },
  {
    empresa: "Adelantia IT Solutions",
    rol: "Técnico en prácticas",
    periodo: "Mar. 2022 — Jun. 2022",
    ubicacion: "Almería",
    descripcion: "Prácticas de ciclo medio en empresa de servicios IT. Administración y mantenimiento de equipos, instalación de sistemas operativos, configuración de redes y soporte técnico. Primer contacto profesional con entornos reales de trabajo.",
    actual: false,
  },
];

const formacion = [
  {
    centro: "IES Celia Viñas",
    titulo: "Desarrollo de Aplicaciones Multiplataforma",
    kind: "CFGS · DAM",
    periodo: "2022 — 2025",
  },
  {
    centro: "IES Celia Viñas",
    titulo: "Sistemas Microinformáticos y Redes",
    kind: "CFGM · SMR",
    periodo: "2019 — 2022",
  },
];

const servicios = [
  {
    num: "01",
    titulo: "Webs y landing pages",
    descripcion: "Sitios rápidos, cuidados y con buen SEO técnico. Astro, React y TypeScript.",
  },
  {
    num: "02",
    titulo: "Apps móvil",
    descripcion: "Apps nativas y multiplataforma con Kotlin Multiplatform (KMP), desde una única base de código para Android e iOS.",
  },
  {
    num: "03",
    titulo: "Producto propio",
    descripcion: "VexelPlayPro es mi propio producto SaaS, ya validado en producción. Si buscas algo más que una web —una plataforma completa con backend, usuarios y lógica de negocio— también puedo construírtela desde cero.",
  },
];

const proyectos = [
  {
    titulo: "VexelPlayPro",
    descripcion: "Plataforma propia que empezó en web y va creciendo hacia móvil con Kotlin Multiplatform. Un proyecto real donde tomo todas las decisiones: producto, arquitectura y diseño.",
    tecnologias: ["React", "TypeScript", "KMP"],
    num: "01",
    badge: "En progreso",
    links: [
      { tipo: "web", label: "Ver web", url: "https://vexelplaypro.com" },
    ],
  },
  {
    titulo: "Spider-Man: Brand New Day",
    descripcion: "Colaboración freelance en la web promocional de la película, junto al desarrollador y streamer Midudev.",
    tecnologias: ["Astro", "TypeScript", "Freelance"],
    num: "02",
    badge: "Freelance",
    links: [
      { tipo: "web", label: "Ver web", url: "https://spidermanbrandnewday.es" },
    ],
  },
  {
    titulo: "marp0604-portfolio",
    descripcion: "Este portfolio. Construido con Astro, animaciones CSS propias y fuentes auto-alojadas. Diseño de alto impacto visual sin una sola librería de componentes. Código abierto.",
    tecnologias: ["Astro", "CSS", "TypeScript"],
    num: "03",
    badge: null,
    links: [
      { tipo: "repo", label: "Repositorio", url: "https://github.com/marp0604/marp0604-portfolio" },
      { tipo: "web", label: "Ver web", url: "https://marp0604.com" },
    ],
  },
];

// Proyectos de aprendizaje: se muestran aparte, con menos peso visual, para que
// los primeros casos que se vean sean los reales (VexelPlayPro y Spider-Man).
const otrosProyectos = [
  {
    titulo: "Rick & Morty App",
    descripcion: "App Android nativa en Kotlin que consume la Rick & Morty API: navegación por temporadas, listado de episodios y fichas de personajes.",
    tecnologias: ["Kotlin", "Android", "REST API"],
    repo: "https://github.com/marp0604/APIRickYMorty",
  },
  {
    titulo: "Gestión de Tareas",
    descripcion: "Aplicación de escritorio en Java con arquitectura MVC. Gestión de tareas organizadas por proyectos sobre MySQL, con interfaz en Swing.",
    tecnologias: ["Java", "MVC", "MySQL"],
    repo: "https://github.com/marp0604/GestionTareas",
  },
];

const stackGrupos = [
  {
    categoria: "Frontend",
    skills: ["HTML", "CSS", "JavaScript", "TypeScript", "React", "Astro"],
  },
  {
    categoria: "Herramientas",
    skills: ["Git", "GitHub", "Vite", "Node.js", "npm"],
  },
  {
    categoria: "Explorando",
    skills: ["Kotlin Multiplatform", "Tailwind CSS", "Figma"],
  },
];

// Preguntas frecuentes: redactadas como las buscaría un cliente (servicio + ciudad,
// Android/iOS, presupuesto…) y con la respuesta directa en la primera frase, que es
// lo que citan Google y las IAs. Solo usan datos que ya cuenta la web: nada de
// precios ni plazos inventados. Van en texto plano porque alimentan también el
// FAQPage del JSON-LD.
const preguntas = [
  {
    pregunta: "¿Eres desarrollador freelance en Almería?",
    respuesta: "Sí. Soy Miguel Ángel Ramírez Pérez (marp0604), desarrollador multiplataforma en Almería (Andalucía, España). Trabajo como desarrollador en Farmacias.com y, en paralelo, acepto proyectos freelance de desarrollo web y de apps móviles.",
  },
  {
    pregunta: "¿Qué servicios de desarrollo web ofreces?",
    respuesta: "Desarrollo webs y landing pages rápidas, cuidadas y con buen SEO técnico, hechas con Astro, React y TypeScript. Son sitios ligeros y preparados para que Google los entienda bien, como esta misma web.",
  },
  {
    pregunta: "¿Desarrollas apps móviles para Android e iOS?",
    respuesta: "Sí. Desarrollo apps nativas y multiplataforma con Kotlin Multiplatform (KMP), que permite tener una única base de código para Android e iOS. Es la tecnología con la que estoy llevando VexelPlayPro, mi producto propio, de la web al móvil.",
  },
  {
    pregunta: "¿Qué es Kotlin Multiplatform y qué ventajas tiene?",
    respuesta: "Kotlin Multiplatform (KMP) es una tecnología de JetBrains para compartir código entre Android, iOS y otras plataformas sin renunciar a la experiencia nativa. Se comparte la lógica de la app (y, si se quiere, también la interfaz con Compose Multiplatform), así que hay una sola base de código que mantener en lugar de dos.",
  },
  {
    pregunta: "¿Puedes crear una plataforma o un SaaS a medida?",
    respuesta: "Sí. Además de webs y apps, construyo plataformas completas desde cero, con backend, usuarios y lógica de negocio. Es lo que he hecho con VexelPlayPro, mi propio producto SaaS, ya validado en producción.",
  },
  {
    pregunta: "¿Con qué tecnologías trabajas?",
    respuesta: "En frontend, con Astro, React y TypeScript, sobre HTML, CSS y JavaScript. En móvil, con Kotlin Multiplatform. En el día a día uso Git, GitHub, Vite, Node.js y npm, y estoy explorando Tailwind CSS y Figma.",
  },
  {
    pregunta: "¿Qué experiencia y formación tienes?",
    respuesta: "Soy Técnico Superior en Desarrollo de Aplicaciones Multiplataforma (DAM) y Técnico en Sistemas Microinformáticos y Redes (SMR), ambos por el IES Celia Viñas de Almería. Desde febrero de 2026 trabajo como desarrollador en Farmacias.com, sobre una plataforma de comercio electrónico real, y he colaborado como freelance en la web promocional de Spider-Man: Brand New Day junto a Midudev.",
  },
  {
    pregunta: "¿Cómo puedo pedirte presupuesto?",
    respuesta: "Escríbeme por email desde la sección de contacto de esta web o por LinkedIn, cuéntame qué necesitas y lo hablamos. Si antes quieres conocer mi trayectoria, puedes descargar mi CV en PDF.",
  },
];

// Datos estructurados (schema.org) en un @graph: página de perfil, sitio, persona y
// proyectos, enlazados por @id. Salen de los mismos arrays que pintan la página, así
// que Google y los buscadores con IA leen lo mismo que ve el visitante.
// El email no va aquí a propósito: en la página está ofuscado.
const personaId = `${canonicalURL}#persona`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${canonicalURL}#perfil`,
      "url": canonicalURL,
      "name": titulo,
      "description": descripcion,
      "inLanguage": "es-ES",
      "dateModified": new Date().toISOString(),
      "isPartOf": { "@id": `${canonicalURL}#web` },
      "mainEntity": { "@id": personaId },
      "primaryImageOfPage": { "@type": "ImageObject", "url": ogImage, "width": 1200, "height": 630 },
    },
    {
      "@type": "WebSite",
      "@id": `${canonicalURL}#web`,
      "url": canonicalURL,
      "name": "marp0604",
      "alternateName": "Miguel Ángel Ramírez Pérez",
      "inLanguage": "es-ES",
      "publisher": { "@id": personaId },
    },
    {
      "@type": "Person",
      "@id": personaId,
      "name": "Miguel Ángel Ramírez Pérez",
      "givenName": "Miguel Ángel",
      "familyName": "Ramírez Pérez",
      "alternateName": "marp0604",
      "url": canonicalURL,
      "image": { "@type": "ImageObject", "url": `${canonicalURL}perfil.jpg`, "width": 460, "height": 460 },
      "jobTitle": rol,
      "description": descripcion,
      "address": { "@type": "PostalAddress", "addressLocality": "Almería", "addressRegion": "Andalucía", "addressCountry": "ES" },
      "nationality": { "@type": "Country", "name": "España" },
      "knowsLanguage": "es",
      "worksFor": { "@type": "Organization", "name": "Farmacias.com" },
      "alumniOf": { "@type": "EducationalOrganization", "name": "IES Celia Viñas", "address": { "@type": "PostalAddress", "addressLocality": "Almería", "addressCountry": "ES" } },
      "hasCredential": formacion.map((f) => ({
        "@type": "EducationalOccupationalCredential",
        "name": `${f.kind.startsWith("CFGS") ? "Técnico Superior" : "Técnico"} en ${f.titulo}`,
        "credentialCategory": f.kind.startsWith("CFGS") ? "Ciclo Formativo de Grado Superior" : "Ciclo Formativo de Grado Medio",
        "recognizedBy": { "@type": "EducationalOrganization", "name": f.centro },
      })),
      "knowsAbout": [...stackGrupos.flatMap((g) => g.skills), "Desarrollo web", "Desarrollo de apps móviles", "SEO técnico"],
      "makesOffer": servicios.map((s) => ({
        "@type": "Offer",
        "itemOffered": { "@type": "Service", "name": s.titulo, "description": s.descripcion, "provider": { "@id": personaId } },
      })),
      "sameAs": ["https://github.com/marp0604", "https://linkedin.com/in/marp0604"],
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalURL}#proyectos`,
      "name": "Proyectos de Miguel Ángel Ramírez Pérez",
      "itemListElement": proyectos.map((p, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": {
          "@type": "CreativeWork",
          "name": p.titulo,
          "description": p.descripcion,
          "url": (p.links.find((l) => l.tipo === "web") ?? p.links[0]).url,
          "keywords": p.tecnologias.join(", "),
          // En las colaboraciones freelance participa; los propios los crea él
          [p.badge === "Freelance" ? "contributor" : "creator"]: { "@id": personaId },
        },
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalURL}#preguntas-frecuentes`,
      "url": `${canonicalURL}#preguntas-frecuentes`,
      "inLanguage": "es-ES",
      "isPartOf": { "@id": `${canonicalURL}#web` },
      "about": { "@id": personaId },
      "mainEntity": preguntas.map((q) => ({
        "@type": "Question",
        "name": q.pregunta,
        "acceptedAnswer": { "@type": "Answer", "text": q.respuesta },
      })),
    },
  ],
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="author" content="Miguel Ángel Ramírez Pérez" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />

    <meta name="theme-color" content="#16181d" />

    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content="Miguel Ángel" />
    <meta property="profile:last_name" content="Ramírez Pérez" />
    <meta property="profile:username" content="marp0604" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Miguel Ángel Ramírez Pérez — Construyo productos útiles para mi entorno" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="marp0604.com" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Miguel Ángel Ramírez Pérez — Construyo productos útiles para mi entorno" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>

    <a href="#main-content" class="skip-link">Saltar al contenido</a>

    <header>
      <nav aria-label="Navegación principal" id="nav">
        <a href="/" class="nav-logo" aria-label="Inicio — marp0604">
          <LogoMark class="nav-logo-mark" />
          <span class="nav-logo-word">marp0604</span>
        </a>
        <ul class="nav-links" role="list">
          <li><a href="#sobre-mi">Sobre mí</a></li>
          <li><a href="#servicios">Servicios</a></li>
          <li><a href="#experiencia">Experiencia</a></li>
          <li><a href="#formacion">Formación</a></li>
          <li><a href="#proyectos">Proyectos</a></li>
          <li><a href="#stack">Stack</a></li>
          <li><a href="#preguntas-frecuentes">FAQ</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
        <a href="#contacto" class="nav-available" aria-label="Disponible para proyectos freelance — ir a contacto">
          <span class="dot" aria-hidden="true"></span>
          {/* La cola se oculta en pantallas estrechas: queda solo «Disponible» */}
          <span>Disponible<span class="nav-available-tail"> para proyectos freelance</span></span>
        </a>
        <button
          class="nav-hamburger"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="nav-mobile-overlay"
          id="nav-hamburger-btn"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </nav>
    </header>

    <div
      id="nav-mobile-overlay"
      class="nav-mobile-overlay"
      role="dialog"
      aria-label="Menú de navegación"
      aria-modal="true"
    >
      <LogoMark class="nav-mobile-logo" />
      <p class="nav-mobile-available">
        <span class="dot" aria-hidden="true"></span>
        Disponible para proyectos freelance
      </p>
      <ul class="nav-mobile-links" role="list">
        <li><a href="#sobre-mi" class="nav-mobile-link">Sobre mí</a></li>
        <li><a href="#servicios" class="nav-mobile-link">Servicios</a></li>
        <li><a href="#experiencia" class="nav-mobile-link">Experiencia</a></li>
        <li><a href="#formacion" class="nav-mobile-link">Formación</a></li>
        <li><a href="#proyectos" class="nav-mobile-link">Proyectos</a></li>
        <li><a href="#stack" class="nav-mobile-link">Stack</a></li>
        <li><a href="#preguntas-frecuentes" class="nav-mobile-link">FAQ</a></li>
        <li><a href="#contacto" class="nav-mobile-link">Contacto</a></li>
      </ul>
      <div class="nav-mobile-footer">
        <a href="https://github.com/marp0604" target="_blank" rel="noopener noreferrer" aria-label="GitHub (abre en nueva pestaña)">
          <IconGitHub />
          GitHub
        </a>
        <a href="https://linkedin.com/in/marp0604" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (abre en nueva pestaña)">
          <IconLinkedIn />
          LinkedIn
        </a>
        <a href={cvUrl} download aria-label="Descargar CV en PDF">
          <IconCV />
          CV
        </a>
      </div>
    </div>

    <main id="main-content">

      <section class="hero" aria-label="Presentación" id="top">
        <div class="bg-glow" aria-hidden="true"></div>
        <div class="bg-grid" aria-hidden="true"></div>
        <div class="glow-blob" aria-hidden="true"></div>
        <div class="container">
          {/* El nombre y el rol van dentro del h1 (para buscadores), con el mismo aspecto.
              La portada no lleva .reveal: se pinta al instante (mejor LCP y Speed Index). */}
          <h1>
            <span class="eyebrow">
              <span>Miguel Ángel Ramírez Pérez</span>
              <span class="accent">desarrollador multiplataforma</span>
            </span>
            <span class="hero-title">
              Construyo productos <span class="accent">útiles</span> para mi entorno<span class="cursor" aria-hidden="true"></span>
            </span>
          </h1>
          <div class="hero-lower">
            <p class="hero-desc">
              Frontend sólido, arquitectura pensada. Del web al móvil con <strong>Kotlin Multiplatform</strong>. Desde Almería, España.
            </p>
            <div class="hero-actions">
              <a href="#proyectos" class="btn btn-primary">
                Ver proyectos
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
              <a href="#contacto" class="btn btn-ghost">Contactar</a>
            </div>
          </div>
          <div class="hero-foot" aria-hidden="true">
            <span class="hero-scroll">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
              Scroll
            </span>
            <span class="hero-coords">Almería · 36.83°N 2.46°W</span>
          </div>
        </div>
      </section>

      <div class="container">

        <section class="section" id="sobre-mi" aria-labelledby="title-sobre-mi">
          <h2 class="section-eyebrow reveal"><span id="title-sobre-mi">sobre mí</span></h2>
          <div class="about-grid">
            <div class="about-photo reveal">
              <img
                src="/perfil.jpg"
                alt="Miguel Ángel Ramírez Pérez — Desarrollador Multiplataforma"
                width="340"
                height="340"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="reveal">
              <p class="about-statement">
                Escribo código como quien afina un <em>instrumento</em>: buscando el gesto justo, sin ruido.
              </p>
              <div class="about-bio">
                <p>
                  Estudié DAM en el IES Celia Viñas de Almería. Aprendí a programar de verdad: algoritmos, estructuras de datos, lógica sin atajos. Después aterricé en el frontend, donde esa base importa más.
                </p>
                <p>
                  Hoy trabajo en Farmacias.com sobre un e-commerce real y en paralelo desarrollo VexelPlayPro, mi proyecto propio, que ya camina hacia móvil con Kotlin Multiplatform.
                </p>
              </div>
              <div class="about-quick">
                <div class="about-quick-row">
                  <span class="about-quick-key">Rol</span>
                  <span class="about-quick-val">Desarrollador Multiplataforma</span>
                </div>
                <div class="about-quick-row">
                  <span class="about-quick-key">Stack</span>
                  <span class="about-quick-val">Astro · React · TypeScript · KMP</span>
                </div>
                <div class="about-quick-row">
                  <span class="about-quick-key">Ubicación</span>
                  <span class="about-quick-val">Almería, España</span>
                </div>
                <div class="about-quick-row">
                  <span class="about-quick-key">Empresa</span>
                  <span class="about-quick-val">Farmacias.com · Presente</span>
                </div>
                <div class="about-quick-row">
                  <span class="about-quick-key">Email</span>
                  <span class="about-quick-val" id="email-display">
                    <noscript><a href="mailto:contacto&#64;marp0604&#46;com">contacto&#64;marp0604&#46;com</a></noscript>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section" id="servicios" aria-labelledby="title-servicios">
          <p class="section-eyebrow reveal"><span>servicios</span></p>
          <h2 class="section-title reveal" id="title-servicios">En qué puedo ayudarte</h2>
          <div class="serv-grid">
            {servicios.map((s) => (
              <article class="serv-card reveal">
                <h3 class="serv-titulo">
                  <span class="serv-num" aria-hidden="true">{s.num} ·</span>
                  {s.titulo}
                </h3>
                <p class="serv-desc">{s.descripcion}</p>
              </article>
            ))}
          </div>
          <div class="serv-cta reveal">
            <a href="#contacto" class="btn btn-primary">
              Hablemos de tu proyecto
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </section>

        <section class="section" id="experiencia" aria-labelledby="title-experiencia">
          <h2 class="section-eyebrow reveal"><span id="title-experiencia">experiencia</span></h2>
          <div class="exp-list">
            {experiencia.map((e) => (
              <article class="exp-card reveal">
                <div class="exp-meta">
                  <span class="exp-date">{e.periodo}</span>
                  <span class="exp-place">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    {e.ubicacion}
                  </span>
                </div>
                <div>
                  <h3 class="exp-empresa">
                    {e.empresa}
                    {e.actual && (
                      <span class="badge-actual"><span class="dot" aria-hidden="true"></span>Actual</span>
                    )}
                  </h3>
                  <p class="exp-rol">{e.rol}</p>
                  <p class="exp-desc">{e.descripcion}</p>
                </div>
                <span class="exp-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
                </span>
              </article>
            ))}
          </div>
        </section>

        <section class="section" id="formacion" aria-labelledby="title-formacion">
          <h2 class="section-eyebrow reveal"><span id="title-formacion">formación</span></h2>
          <div class="edu-grid">
            {formacion.map((f) => (
              <article class="edu-card reveal">
                <p class="edu-kind">{f.kind}</p>
                <h3 class="edu-titulo">{f.titulo}</h3>
                <div class="edu-foot">
                  <span>{f.centro}</span>
                  <span class="date">{f.periodo}</span>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="section" id="proyectos" aria-labelledby="title-proyectos">
          <h2 class="section-eyebrow reveal"><span id="title-proyectos">proyectos</span></h2>
          <div class="proyecto-list">
            {proyectos.map((p) => (
              <article class="proyecto-item reveal">
                <span class="proyecto-num" aria-hidden="true">{p.num}</span>
                <div>
                  <div class="proyecto-title-row">
                    <h3 class="proyecto-name">{p.titulo}</h3>
                    {p.badge && <span class="proyecto-badge">{p.badge}</span>}
                  </div>
                  <p class="proyecto-desc">{p.descripcion}</p>
                  <div class="proyecto-tags">
                    {p.tecnologias.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </div>
                  <div class="proyecto-links">
                    {p.links.map((l) => (
                      <a
                        href={l.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="proyecto-link"
                        aria-label={`${l.label} de ${p.titulo} (abre en nueva pestaña)`}
                      >
                        {l.tipo === "repo" && <IconGitHub />}
                        <span>{l.label}</span>
                        <span class="arrow" aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="otros">
            <p class="otros-label reveal">Otros proyectos <span aria-hidden="true">·</span> aprendizaje</p>
            <div class="otros-grid">
              {otrosProyectos.map((p) => (
                <article class="otros-card reveal">
                  <h3 class="otros-titulo">{p.titulo}</h3>
                  <p class="otros-desc">{p.descripcion}</p>
                  <div class="otros-foot">
                    <div class="proyecto-tags">
                      {p.tecnologias.map((t) => (
                        <span class="tag">{t}</span>
                      ))}
                    </div>
                    <a
                      href={p.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="otros-link"
                      aria-label={`Repositorio de ${p.titulo} (abre en nueva pestaña)`}
                    >
                      <IconGitHub />
                      <span>Repositorio</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="section" id="stack" aria-labelledby="title-stack">
          <h2 class="section-eyebrow reveal"><span id="title-stack">stack</span></h2>
          <div class="stack-grid">
            {stackGrupos.map((g) => (
              <div class="stack-card reveal">
                <h3 class="stack-label"><span class="dot" aria-hidden="true"></span>{g.categoria}</h3>
                <ul class="stack-items" role="list">
                  {g.skills.map((s) => (
                    <li class={g.categoria === "Explorando" ? "is-explore" : ""}>
                      <span>{s}</span>
                      <span class="sig" aria-hidden="true">///</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section class="section" id="preguntas-frecuentes" aria-labelledby="title-preguntas-frecuentes">
          <div class="faq-grid">
            <div class="faq-intro reveal">
              <p class="section-eyebrow"><span>dudas</span></p>
              <h2 class="section-title" id="title-preguntas-frecuentes">Preguntas frecuentes sobre trabajar conmigo</h2>
              <p class="faq-intro-text">¿Tu duda no está aquí? Escríbeme y lo hablamos.</p>
              <a href="#contacto" class="btn btn-ghost">
                Hacer otra pregunta
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </div>
            {/* Acordeón nativo (<details>): se abre sin JS y el texto sigue en el HTML para
                buscadores. Con name="faq" solo queda una abierta a la vez; la primera viene
                abierta como muestra. */}
            <div class="faq-list">
              {preguntas.map((q, i) => (
                <details class="faq-item reveal" name="faq" open={i === 0}>
                  <summary>
                    <span class="faq-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                    <h3 class="faq-q">{q.pregunta}</h3>
                    <span class="faq-icon" aria-hidden="true"></span>
                  </summary>
                  <p class="faq-a">{q.respuesta}</p>
                </details>
              ))}
            </div>
          </div>
        </section>

      </div>

      <section class="contact" id="contacto" aria-labelledby="title-contacto">
        <div class="bg-glow" aria-hidden="true"></div>
        <div class="bg-grid" aria-hidden="true"></div>
        <div class="glow-blob" aria-hidden="true"></div>
        <div class="container">
          <p class="section-eyebrow reveal"><span>contacto</span></p>
          <h2 class="contact-title reveal" id="title-contacto">
            Hablemos de
            <span class="accent">tu proyecto<span class="cursor" aria-hidden="true"></span></span>
          </h2>
          <p class="contact-desc reveal">
            ¿Tienes un proyecto en mente? Trabajo en Farmacias.com y en paralelo acepto proyectos freelance de desarrollo web y apps. Escríbeme y hablamos.
          </p>
          <div class="contact-actions reveal">
            <button id="contact-btn" class="contact-email" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span id="contact-btn-text">Enviar email</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </button>
            <noscript>
              <a class="contact-email" href="mailto:contacto&#64;marp0604&#46;com">
                contacto&#64;marp0604&#46;com
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </noscript>
            {/* Alternativa al mailto para quien no tiene programa de correo: main.js lo
                muestra solo si hay JS y portapapeles */}
            <button id="copy-email-btn" class="btn btn-ghost" type="button" hidden>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span id="copy-email-text" aria-live="polite">Copiar email</span>
            </button>
            <a
              href="https://linkedin.com/in/marp0604"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost"
              aria-label="LinkedIn (abre en nueva pestaña)"
            >
              <IconLinkedIn size={16} />
              LinkedIn
            </a>
            <a
              href="https://github.com/marp0604"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost"
              aria-label="GitHub (abre en nueva pestaña)"
            >
              <IconGitHub size={16} />
              GitHub
            </a>
            <a href={cvUrl} download class="btn btn-ghost" aria-label="Descargar CV en PDF">
              <IconCV size={16} />
              Descargar CV
            </a>
          </div>
        </div>
      </section>

    </main>

    <footer>
      <div class="container">
        <div class="footer-grid">
          <span>© {new Date().getFullYear()} Miguel Ángel Ramírez Pérez</span>
          <span class="footer-mid">hecho con <span class="footer-heart" aria-label="amor">♥</span> en Almería</span>
          <a
            href="https://github.com/marp0604/marp0604-portfolio"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-src"
            aria-label="Código fuente en GitHub (abre en nueva pestaña)"
          >
            <IconGitHub />
            Ver código fuente
          </a>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/main.js';
    </script>

  </body>
</html>
