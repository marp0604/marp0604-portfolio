---
// Logo >MA_ del kit de marca: chevrón en JetBrains Mono, «MA» en Inter Black y
// cursor como barra. Es texto con las fuentes auto-alojadas, así que se ve nítido
// a cualquier tamaño; el tamaño se controla con font-size desde la clase.
// Sin estilos inline: la CSP (style-src 'self') los bloquearía.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<span class:list={["logo-ma", className]} aria-hidden="true"><span class="logo-ma-chev">&gt;</span>MA<span class="logo-ma-cursor"></span></span>
